{
  "name": "sister-audiobook-cabin",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "dev:api": "node audiobook-server.mjs",
    "build": "tsc -b && vite build && node scripts/build-pwa.mjs",
    "preview": "vite preview",
    "serve": "node audiobook-server.mjs",
    "ts-check": "tsc -b",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "videos:probe": "node scripts/prepare-videos.mjs probe",
    "videos:prepare": "node scripts/prepare-videos.mjs prepare",
    "videos:verify": "node scripts/prepare-videos.mjs verify",
    "audio:scan": "node scripts/scan-audio.mjs"
  },
  "dependencies": {
    "i18next": "25.6.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-i18next": "16.2.0",
    "react-router-dom": "^7.6.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.28.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.0",
    "eslint": "^9.28.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.2.0",
    "jsdom": "^26.1.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.34.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0"
  }
}
